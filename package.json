{
  "name": "browser-codeium",
  "version": "0.3.0",
  "private": false,
  "description": "A GitHub Pages IDE with Monaco, tree-sitter, WebGPU, and local-first AI coding workflows.",
  "type": "module",
  "homepage": "https://baditaflorin.github.io/browser-codeium/",
  "repository": {
    "type": "git",
    "url": "https://github.com/baditaflorin/browser-codeium.git"
  },
  "license": "MIT",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "prebuild": "node scripts/clean-pages-build.mjs && node scripts/copy-tree-sitter-assets.mjs",
    "build": "vite build && node scripts/write-spa-fallback.mjs && node scripts/check-pages-build.mjs && node scripts/check-asset-budget.mjs",
    "preview": "vite preview --host 127.0.0.1 --port 4179 --strictPort",
    "data": "node scripts/validate-static-data.mjs",
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "smoke": "bash scripts/smoke.sh",
    "lint": "eslint .",
    "fmt": "prettier --write .",
    "fmt:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "hooks:pre-commit": "npm run fmt:check && npm run lint && npm run typecheck && gitleaks protect --staged --verbose",
    "hooks:commit-msg": "node scripts/validate-commit-msg.mjs",
    "hooks:pre-push": "make test && make build && make smoke",
    "audit": "npm audit --audit-level=high"
  },
  "dependencies": {
    "@monaco-editor/react": "^4.7.0",
    "@tanstack/react-query": "^5.90.7",
    "@vscode/tree-sitter-wasm": "^0.3.1",
    "idb": "^8.0.3",
    "lucide-react": "^0.468.0",
    "monaco-editor": "^0.52.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "web-tree-sitter": "^0.26.8",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@playwright/test": "^1.49.1",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/node": "^22.10.5",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/coverage-v8": "^2.1.8",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.17.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.16",
    "globals": "^15.14.0",
    "jsdom": "^25.0.1",
    "postcss": "^8.4.49",
    "prettier": "^3.4.2",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.19.1",
    "vite": "^6.0.7",
    "vitest": "^2.1.8"
  }
}
